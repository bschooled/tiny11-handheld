#Requires -Version 7.0

<#
.SYNOPSIS
    Enhanced Autounattend.xml generation module with comprehensive configuration support.

.DESCRIPTION
    Generates autounattend.xml with support for:
    - Privacy settings (telemetry, Copilot, app suggestions)
    - Security settings (UAC, SmartScreen, VBS, device encryption)
    - UI settings (file extensions, taskbar, Start menu)
    - Performance settings (long paths, fast startup)
    - Development settings (PowerShell execution policy)
    - Browser settings (Edge first run, startup boost)
    
.NOTES
    Module: Autounattend.psm1
    Requires: PowerShell 7.0+
    Version: 3.0.0 - Refactored to use inline commands instead of Extensions (ISO boot compatible)
#>

function New-AutounattendXml {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory = $true)]
        [hashtable]$Config,

        [Parameter(Mandatory = $true)]
        [string]$OutputPath
    )

    Write-LogInfo "Generating enhanced autounattend.xml (inline commands, ISO-compatible)..."

    # ===== Extract Basic Configuration =====
    $bypassTPM = $false
    $bypassSecureBoot = $false
    $bypassRAM = $false
    $bypassCPU = $false
    $bypassStorage = $false
    $bypassDisk = $false
    $bypassUpgradeTPMCPU = $false
    $disableAppraiser = $false
    $suppressHardwareWarnings = $false
    $usbInstall = $false

    if ($Config.features) {
        if ($Config.features.bypassSystemRequirements -eq $true) {
            $bypassTPM = $bypassSecureBoot = $bypassRAM = $bypassCPU = $bypassStorage = $bypassDisk = $bypassUpgradeTPMCPU = $disableAppraiser = $suppressHardwareWarnings = $true
        } else {
            $bypassTPM = $Config.features.bypassTPM -eq $true
            $bypassSecureBoot = $Config.features.bypassSecureBoot -eq $true
            $bypassRAM = $Config.features.bypassRAMCheck -eq $true
            $bypassCPU = $Config.features.bypassCPUCheck -eq $true
            $bypassStorage = $Config.features.bypassStorageCheck -eq $true
            $bypassDisk = $Config.features.bypassDiskCheck -eq $true
            $bypassUpgradeTPMCPU = $Config.features.bypassUpgradeTPMCPUCheck -eq $true
            $disableAppraiser = $Config.features.disableCompatibilityAppraiser -eq $true
            $suppressHardwareWarnings = $Config.features.suppressUnsupportedHardwareWarnings -eq $true
        }
    }

    # Also check security.bypassRequirementsCheck
    if ($Config.security -and $Config.security.bypassRequirementsCheck -eq $true) {
        $bypassTPM = $bypassSecureBoot = $bypassRAM = $bypassCPU = $bypassStorage = $bypassDisk = $bypassUpgradeTPMCPU = $disableAppraiser = $suppressHardwareWarnings = $true
        Write-LogDebug "Bypasses enabled via security.bypassRequirementsCheck"
    }

    # Enable USB install handling
    if ($Config.security -and $Config.security.enableUsbInstallation -eq $true) {
        $usbInstall = $true
    }

    Write-LogDebug "Bypass flags - TPM: $bypassTPM, SecureBoot: $bypassSecureBoot, RAM: $bypassRAM, CPU: $bypassCPU, Storage: $bypassStorage, Disk: $bypassDisk, UpgradeTPMCPU: $bypassUpgradeTPMCPU, Appraiser: $disableAppraiser, HardwareWarnings: $suppressHardwareWarnings, USB: $usbInstall"

    # Basic settings
    $computerName = ""
    $productKey = "YTMG3-N6DKC-DKB77-7M9GH-8HVX7"
    $timezone = "Pacific Standard Time"
    $locale = "en-US"
    $keyboardLayout = "0409:00000409"
    $username = ""
    $password = ""
    $userGroup = "Administrators"

    if ($Config.unattended) {
        if ($Config.unattended.computerName) { $computerName = $Config.unattended.computerName }
        if ($Config.unattended.productKey) { $productKey = $Config.unattended.productKey }
        if ($Config.unattended.timezone) { $timezone = $Config.unattended.timezone }
        if ($Config.unattended.locale) { $locale = $Config.unattended.locale }
        if ($Config.unattended.keyboardLayout) { $keyboardLayout = $Config.unattended.keyboardLayout }
        if ($Config.unattended.userAccount) {
            if ($Config.unattended.userAccount.username) { $username = $Config.unattended.userAccount.username }
            if ($Config.unattended.userAccount.password) { $password = $Config.unattended.userAccount.password }
            if ($Config.unattended.userAccount.group) { $userGroup = $Config.unattended.userAccount.group }
        }
    }

    # Support top-level locale/timezone/keyboard for new schema
    if ($Config.locale) { $locale = $Config.locale }
    if ($Config.timezone) { $timezone = $Config.timezone }
    if ($Config.keyboard) { $keyboardLayout = $Config.keyboard }
    if ($Config.userAccount) {
        if ($Config.userAccount.username) { $username = $Config.userAccount.username }
        if ($Config.userAccount.password) { $password = $Config.userAccount.password }
        if ($Config.userAccount.group) { $userGroup = $Config.userAccount.group }
    }

    # ===== Build windowsPE Bypass Commands (with wcm:keyValue) =====
    $bypassCommands = @()
    if ($bypassTPM) {
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup\LabConfig" /v BypassTPMCheck /t REG_DWORD /d 1 /f'
    }
    if ($bypassSecureBoot) {
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup\LabConfig" /v BypassSecureBootCheck /t REG_DWORD /d 1 /f'
    }
    if ($bypassRAM) {
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup\LabConfig" /v BypassRAMCheck /t REG_DWORD /d 1 /f'
    }
    if ($bypassCPU) {
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup\LabConfig" /v BypassCPUCheck /t REG_DWORD /d 1 /f'
    }
    if ($bypassStorage) {
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup\LabConfig" /v BypassStorageCheck /t REG_DWORD /d 1 /f'
    }
    if ($bypassDisk) {
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup\LabConfig" /v BypassDiskCheck /t REG_DWORD /d 1 /f'
    }
    if ($bypassUpgradeTPMCPU) {
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup\MoSetup" /v AllowUpgradesWithUnsupportedTPMOrCPU /t REG_DWORD /d 1 /f'
    }
    if ($disableAppraiser) {
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup" /v CmdLine /t REG_SZ /d "" /f'
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup" /v OOBEInProgress /t REG_DWORD /d 1 /f'
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup" /v SetupPhase /t REG_DWORD /d 0 /f'
    }
    if ($suppressHardwareWarnings) {
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup" /v UnsupportedHardwareNotificationCache /t REG_DWORD /d 0 /f'
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup" /v UnsupportedHardwareNotificationCacheTime /t REG_QWORD /d 0 /f'
    }
    if ($usbInstall) {
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\CurrentControlSet\Control" /v PortableOperatingSystem /t REG_DWORD /d 0 /f'
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup" /v AllowRemovableMedia /t REG_DWORD /d 1 /f'
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup" /v ForceRemovableInstall /t REG_DWORD /d 1 /f'
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup\LabConfig" /v BypassDiskCheck /t REG_DWORD /d 1 /f'
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup\LabConfig" /v BypassStorageCheck /t REG_DWORD /d 1 /f'
        $bypassCommands += 'reg.exe add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v WinToGo /t REG_DWORD /d 0 /f'
        $bypassCommands += 'reg.exe add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v PortableOperatingSystem /t REG_DWORD /d 0 /f'
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup" /v UsbBootSupported /t REG_DWORD /d 1 /f'
        $bypassCommands += 'reg.exe add "HKLM\SYSTEM\Setup" /v UsbInstallAllowed /t REG_DWORD /d 1 /f'
        $bypassCommands += 'reg.exe add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate" /v DisableWUfBSafeguards /t REG_DWORD /d 1 /f'
        $bypassCommands += 'reg.exe add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate" /v TargetReleaseVersion /t REG_DWORD /d 1 /f'
        $bypassCommands += 'reg.exe add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate" /v TargetReleaseVersionInfo /t REG_SZ /d 23H2 /f'
    }

    # Build XML with wcm:keyValue attributes
    $bypassCommandsXml = ""
    for ($i = 0; $i -lt $bypassCommands.Count; $i++) {
        $keyValue = $i + 1
        $bypassCommandsXml += @"

				<RunSynchronousCommand wcm:action="add" wcm:keyValue="$keyValue">
					<Order>$keyValue</Order>
					<Path>$($bypassCommands[$i])</Path>
				</RunSynchronousCommand>
"@
    }
    Write-LogDebug "Built $($bypassCommands.Count) bypass registry commands with wcm:keyValue attributes"

    # ===== Build specialize Pass Inline Commands =====
    $specializeCommands = @()
    
    # First command: create scripts folder (needed for logs, etc.)
    $specializeCommands += 'cmd.exe /c mkdir C:\Windows\Setup\Scripts 2&gt;nul'

    # Bypass requirements in specialize pass too
    if ($bypassTPM -or $bypassSecureBoot -or $bypassRAM) {
        $specializeCommands += 'reg.exe add "HKLM\SYSTEM\Setup\MoSetup" /v AllowUpgradesWithUnsupportedTPMOrCPU /t REG_DWORD /d 1 /f'
    }

    # Security settings
    if ($Config.security) {
        if ($Config.security.disableSmartScreen -eq $true) {
            $specializeCommands += 'reg.exe add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer" /v SmartScreenEnabled /t REG_SZ /d "Off" /f'
            $specializeCommands += 'reg.exe add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\WTDS\Components" /v ServiceEnabled /t REG_DWORD /d 0 /f'
            $specializeCommands += 'reg.exe add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\WTDS\Components" /v NotifyMalicious /t REG_DWORD /d 0 /f'
            $specializeCommands += 'reg.exe add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\WTDS\Components" /v NotifyPasswordReuse /t REG_DWORD /d 0 /f'
            $specializeCommands += 'reg.exe add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\WTDS\Components" /v NotifyUnsafeApp /t REG_DWORD /d 0 /f'
            $specializeCommands += 'reg.exe add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender Security Center\Systray" /v HideSystray /t REG_DWORD /d 1 /f'
        }

        if ($Config.security.disableUac -eq $true) {
            $specializeCommands += 'reg.exe add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v EnableLUA /t REG_DWORD /d 0 /f'
        }

        if ($Config.security.disableVirtualizationBasedSecurity -eq $true) {
            $specializeCommands += 'reg.exe add "HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard" /v EnableVirtualizationBasedSecurity /t REG_DWORD /d 0 /f'
            $specializeCommands += 'reg.exe add "HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard" /v RequirePlatformSecurityFeatures /t REG_DWORD /d 0 /f'
            $specializeCommands += 'reg.exe add "HKLM\SYSTEM\CurrentControlSet\Control\DeviceGuard\Scenarios\HypervisorEnforcedCodeIntegrity" /v Enabled /t REG_DWORD /d 0 /f'
            # Boot-level hypervisor disables
            $specializeCommands += 'cmd.exe /c bcdedit /set hypervisorlaunchtype off'
            $specializeCommands += 'cmd.exe /c bcdedit /set vsmlaunchtype off'
        }

        if ($Config.security.preventDeviceEncryption -eq $true) {
            $specializeCommands += 'reg.exe add "HKLM\SYSTEM\CurrentControlSet\Control\BitLocker" /v PreventDeviceEncryption /t REG_DWORD /d 1 /f'
        }
    }

    # Performance settings
    if ($Config.performance) {
        if ($Config.performance.enableLongPaths -eq $true) {
            $specializeCommands += 'reg.exe add "HKLM\SYSTEM\CurrentControlSet\Control\FileSystem" /v LongPathsEnabled /t REG_DWORD /d 1 /f'
        }

        if ($Config.performance.disableFastStartup -eq $true) {
            $specializeCommands += 'reg.exe add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Power" /v HiberbootEnabled /t REG_DWORD /d 0 /f'
        }
    }

    # Development settings
    if ($Config.development -and $Config.development.allowPowerShellScripts -eq $true) {
        $specializeCommands += 'powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Set-ExecutionPolicy -Scope LocalMachine -ExecutionPolicy RemoteSigned -Force"'
    }

    # UI settings - system level
    if ($Config.ui) {
        if ($Config.ui.disableWidgets -eq $true) {
            $specializeCommands += 'reg.exe add "HKLM\SOFTWARE\Policies\Microsoft\Dsh" /v AllowNewsAndInterests /t REG_DWORD /d 0 /f'
        }

        if ($Config.ui.disableWindowsConsumerFeatures -eq $true) {
            $specializeCommands += 'reg.exe add "HKLM\Software\Policies\Microsoft\Windows\CloudContent" /v DisableWindowsConsumerFeatures /t REG_DWORD /d 1 /f'
        }

        if ($Config.ui.emptyStartPins -eq $true) {
            # Inline PowerShell command to set Start pins JSON
            $specializeCommands += 'powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$json=''{\"\"pinnedList\"\":[]}''; $key=''Registry::HKLM\SOFTWARE\Microsoft\PolicyManager\current\device\Start''; New-Item -Path $key -Force | Out-Null; New-ItemProperty -Path $key -Name ConfigureStartPins -PropertyType String -Value $json -Force | Out-Null"'
        }
    }

    # Browser settings
    if ($Config.browser) {
        if ($Config.browser.hideEdgeFre -eq $true) {
            $specializeCommands += 'reg.exe add "HKLM\Software\Policies\Microsoft\Edge" /v HideFirstRunExperience /t REG_DWORD /d 1 /f'
        }

        if ($Config.browser.disableEdgeStartupBoost -eq $true) {
            $specializeCommands += 'reg.exe add "HKLM\Software\Policies\Microsoft\Edge\Recommended" /v BackgroundModeEnabled /t REG_DWORD /d 0 /f'
            $specializeCommands += 'reg.exe add "HKLM\Software\Policies\Microsoft\Edge\Recommended" /v StartupBoostEnabled /t REG_DWORD /d 0 /f'
        }
    }

    # === Build DefaultUser registry modifications (load, modify inline, unload) ===
    $defaultUserCommands = @()

    # Privacy settings for default user
    if ($Config.privacy) {
        if ($Config.privacy.disableCopilot -eq $true) {
            $defaultUserCommands += 'reg.exe add "HKU\DefaultUser\Software\Policies\Microsoft\Windows\WindowsCopilot" /v TurnOffWindowsCopilot /t REG_DWORD /d 1 /f'
        }

        if ($Config.privacy.disableAppSuggestions -eq $true) {
            # Use single FOR loop for ContentDeliveryManager (matches example template)
            $defaultUserCommands += 'cmd.exe /c for %N in (ContentDeliveryAllowed FeatureManagementEnabled OEMPreInstalledAppsEnabled PreInstalledAppsEnabled PreInstalledAppsEverEnabled SilentInstalledAppsEnabled SoftLandingEnabled SubscribedContentEnabled SubscribedContent-310093Enabled SubscribedContent-338387Enabled SubscribedContent-338388Enabled SubscribedContent-338389Enabled SubscribedContent-338393Enabled SubscribedContent-353694Enabled SubscribedContent-353696Enabled SubscribedContent-353698Enabled SystemPaneSuggestionsEnabled) do reg.exe add "HKU\DefaultUser\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" /v %N /t REG_DWORD /d 0 /f'
        }
    }

    # UI settings - user level
    if ($Config.ui) {
        if ($Config.ui.showFileExtensions -eq $true) {
            $defaultUserCommands += 'reg.exe add "HKU\DefaultUser\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" /v HideFileExt /t REG_DWORD /d 0 /f'
        }

        if ($Config.ui.disableBingResults -eq $true) {
            $defaultUserCommands += 'reg.exe add "HKU\DefaultUser\Software\Policies\Microsoft\Windows\Explorer" /v DisableSearchBoxSuggestions /t REG_DWORD /d 1 /f'
        }

        if ($Config.ui.disableStickyKeys -eq $true) {
            $defaultUserCommands += 'reg.exe add "HKU\DefaultUser\Control Panel\Accessibility\StickyKeys" /v Flags /t REG_SZ /d 10 /f'
        }
    }

    # SmartScreen user settings
    if ($Config.security -and $Config.security.disableSmartScreen -eq $true) {
        $defaultUserCommands += 'reg.exe add "HKU\DefaultUser\Software\Microsoft\Edge\SmartScreenEnabled" /ve /t REG_DWORD /d 0 /f'
        $defaultUserCommands += 'reg.exe add "HKU\DefaultUser\Software\Microsoft\Edge\SmartScreenPuaEnabled" /ve /t REG_DWORD /d 0 /f'
        $defaultUserCommands += 'reg.exe add "HKU\DefaultUser\Software\Microsoft\Windows\CurrentVersion\AppHost" /v EnableWebContentEvaluation /t REG_DWORD /d 0 /f'
        $defaultUserCommands += 'reg.exe add "HKU\DefaultUser\Software\Microsoft\Windows\CurrentVersion\AppHost" /v PreventOverride /t REG_DWORD /d 0 /f'
    }

    # Build specialize RunSynchronous XML with all inline commands
    $specializeXml = ""
    if ($specializeCommands.Count -gt 0 -or $defaultUserCommands.Count -gt 0) {
        $specializeXml = "`n`t`t`t<RunSynchronous>"
        $cmdOrder = 1

        # Add all specialize commands first
        foreach ($cmd in $specializeCommands) {
            $specializeXml += @"

				<RunSynchronousCommand wcm:action="add" wcm:keyValue="$cmdOrder">
					<Order>$cmdOrder</Order>
					<Path>$cmd</Path>
				</RunSynchronousCommand>
"@
            $cmdOrder++
        }

        # Then handle default user hive modifications (load, modify, unload)
        if ($defaultUserCommands.Count -gt 0) {
            # Load hive
            $specializeXml += @"

				<RunSynchronousCommand wcm:action="add" wcm:keyValue="$cmdOrder">
					<Order>$cmdOrder</Order>
					<Path>reg.exe load "HKU\DefaultUser" "C:\Users\Default\NTUSER.DAT"</Path>
				</RunSynchronousCommand>
"@
            $cmdOrder++

            # All default user modifications
            foreach ($cmd in $defaultUserCommands) {
                $specializeXml += @"

				<RunSynchronousCommand wcm:action="add" wcm:keyValue="$cmdOrder">
					<Order>$cmdOrder</Order>
					<Path>$cmd</Path>
				</RunSynchronousCommand>
"@
                $cmdOrder++
            }

            # Unload hive
            $specializeXml += @"

				<RunSynchronousCommand wcm:action="add" wcm:keyValue="$cmdOrder">
					<Order>$cmdOrder</Order>
					<Path>reg.exe unload "HKU\DefaultUser"</Path>
				</RunSynchronousCommand>
"@
        }

        $specializeXml += "`n`t`t`t</RunSynchronous>"
    }

    Write-LogDebug "Built $($specializeCommands.Count) specialize inline commands and $($defaultUserCommands.Count) default user inline commands"

    # ===== Build FirstLogonCommands (Inline) =====
    $firstLogonCommands = @()

    if ($Config.performance -and $Config.performance.disableSystemRestore -eq $true) {
        $firstLogonCommands += 'powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Disable-ComputerRestore -Drive ''C:\'' 2&gt;$null"'
    }

    if ($Config.ui -and $Config.ui.launchToThisPC -eq $true) {
        $firstLogonCommands += 'powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Set-ItemProperty -LiteralPath ''Registry::HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced'' -Name LaunchTo -Type DWord -Value 1"'
    }

    if ($Config.privacy -and $Config.privacy.disableCopilot -eq $true) {
        $firstLogonCommands += 'powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Get-AppxPackage -Name ''Microsoft.Windows.Ai.Copilot.Provider'' -ErrorAction SilentlyContinue | Remove-AppxPackage -ErrorAction SilentlyContinue"'
    }

    # Build FirstLogonCommands XML
    $firstLogonXml = ""
    if ($firstLogonCommands.Count -gt 0) {
        $firstLogonXml = "`n`t`t`t<FirstLogonCommands>"
        for ($i = 0; $i -lt $firstLogonCommands.Count; $i++) {
            $order = $i + 1
            $firstLogonXml += @"

				<SynchronousCommand wcm:action="add" wcm:keyValue="$order">
					<Order>$order</Order>
					<CommandLine>$($firstLogonCommands[$i])</CommandLine>
				</SynchronousCommand>
"@
        }
        $firstLogonXml += "`n`t`t`t</FirstLogonCommands>"
    }

    Write-LogDebug "Built $($firstLogonCommands.Count) first logon inline commands"

    # ===== Build OOBE Components =====
    
    # Parse keyboard layout
    $keyboardParts = $keyboardLayout -split ':'
    $inputLocale = if ($keyboardParts.Count -eq 2) { $keyboardLayout } else { "0409:00000409" }

    # Build computer name
    $computerNameXml = if ([string]::IsNullOrWhiteSpace($computerName)) {
        "<ComputerName>*</ComputerName>"
    } else {
        "<ComputerName>$computerName</ComputerName>"
    }

    # Build OOBE privacy settings
    $oobeProtectPCValue = "3"  # Default: disable all
    if ($Config.privacy -and $Config.privacy.expressSettings) {
        $oobeProtectPCValue = switch ($Config.privacy.expressSettings.ToLower()) {
            "enableall" { "1" }
            "disableall" { "3" }
            default { "3" }
        }
    }

    # Build user accounts with wcm:keyValue on LocalAccount
    $userAccountsXml = if (-not [string]::IsNullOrWhiteSpace($username) -and -not [string]::IsNullOrWhiteSpace($password)) {
        @"

			<UserAccounts>
				<LocalAccounts>
					<LocalAccount wcm:action="add" wcm:keyValue="$username">
						<Name>$username</Name>
						<DisplayName>$username</DisplayName>
						<Group>$userGroup</Group>
						<Password>
							<Value>$password</Value>
							<PlainText>true</PlainText>
						</Password>
					</LocalAccount>
				</LocalAccounts>
			</UserAccounts>
"@
    } else {
        ""
    }

    # Build AutoLogon with correct element ordering
    $autoLogonXml = if (-not [string]::IsNullOrWhiteSpace($username) -and -not [string]::IsNullOrWhiteSpace($password)) {
        @"

			<AutoLogon>
				<Enabled>true</Enabled>
				<LogonCount>1</LogonCount>
				<Username>$username</Username>
				<Password>
					<Value>$password</Value>
					<PlainText>true</PlainText>
				</Password>
			</AutoLogon>
"@
    } else {
        ""
    }

    # ===== Assemble Final XML =====
    $xmlContent = @"
<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:cpi="urn:schemas-microsoft-com:cpi">
	<settings pass="windowsPE">
		<component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
			<SetupUILanguage>
				<UILanguage>$locale</UILanguage>
			</SetupUILanguage>
			<InputLocale>$inputLocale</InputLocale>
			<SystemLocale>$locale</SystemLocale>
			<UILanguage>$locale</UILanguage>
			<UserLocale>$locale</UserLocale>
		</component>
		<component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
			<ImageInstall>
				<OSImage>
					<Compact>true</Compact>
				</OSImage>
			</ImageInstall>
			<UserData>
				<ProductKey>
					<Key>$productKey</Key>
					<WillShowUI>OnError</WillShowUI>
				</ProductKey>
				<AcceptEula>true</AcceptEula>
			</UserData>
			<UseConfigurationSet>true</UseConfigurationSet>
			<RunSynchronous>$bypassCommandsXml
			</RunSynchronous>
		</component>
	</settings>
	<settings pass="specialize">
		<component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
			$computerNameXml
			<TimeZone>$timezone</TimeZone>$specializeXml
		</component>
	</settings>
	<settings pass="oobeSystem">
		<component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
			<InputLocale>$inputLocale</InputLocale>
			<SystemLocale>$locale</SystemLocale>
			<UILanguage>$locale</UILanguage>
			<UserLocale>$locale</UserLocale>
		</component>
		<component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
			<OOBE>
				<ProtectYourPC>$oobeProtectPCValue</ProtectYourPC>
				<HideEULAPage>true</HideEULAPage>
				<HideWirelessSetupInOOBE>false</HideWirelessSetupInOOBE>
				<HideOnlineAccountScreens>true</HideOnlineAccountScreens>
			</OOBE>$userAccountsXml$autoLogonXml$firstLogonXml
		</component>
	</settings>

	<cpi:offlineImage cpi:source="wim:D:\sources\install.wim#Windows 11 Pro" />

</unattend>
"@

    # Write to file
    $xmlContent | Out-File -FilePath $OutputPath -Encoding utf8 -Force
    Write-LogSuccess "Generated: $OutputPath ($(([System.IO.FileInfo]$OutputPath).Length) bytes)"
    
    return $xmlContent
}

Export-ModuleMember -Function New-AutounattendXml
