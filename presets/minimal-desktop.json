{
  "$schema": "../../templates/presets/schema.json",
  "version": "1.0.0",
  
  "metadata": {
    "name": "Minimal Desktop",
    "description": "Lightweight desktop configuration with essential privacy/UI tweaks and bloatware removal",
    "author": "tiny11-handheld",
    "created": "2026-01-22T00:00:00Z"
  },
  
  "source": {
    "architecture": "amd64"
  },
  
  "output": {
    "imageName": "win11-minimal-desktop.iso",
    "outputPath": "./output"
  },
  
  "packages": {
    "removeOneDrive": true,
    "removeList": [
      "Microsoft.BingNews",
      "Microsoft.BingWeather",
      "Microsoft.GamingApp",
      "Microsoft.GetHelp",
      "Microsoft.Getstarted",
      "Microsoft.MicrosoftSolitaireCollection",
      "Microsoft.WindowsFeedbackHub",
      "Microsoft.Xbox.TCUI",
      "Microsoft.XboxApp",
      "Microsoft.XboxGameOverlay",
      "Microsoft.XboxGamingOverlay",
      "Microsoft.YourPhone",
      "Microsoft.ZuneMusic",
      "Microsoft.ZuneVideo"
    ]
  },
  
  "features": {
    "bypassTPM": true,
    "bypassSecureBoot": true,
    "bypassRAMCheck": true,
    "compactOS": false
  },
  
  "unattended": {
    "timezone": "Pacific Standard Time",
    "locale": "en-US",
    "keyboardLayout": "0409:00000409",
    "userAccount": {
      "username": "bschooley",
      "password": "Iafw2day!",
      "group": "Administrators"
    }
  },
  
  "privacy": {
    "disableTelemetry": true,
    "disableAppSuggestions": true,
    "disableCopilot": true,
    "expressSettings": "disableAll"
  },
  
  "ui": {
    "showFileExtensions": true,
    "disableWidgets": true,
    "launchToThisPC": true,
    "disableBingResults": true,
    "disableStickyKeys": true
  },
  
  "performance": {
    "enableLongPaths": true
  },

  "oem": {
    "inject": false,
    "oemPath": null,
    "copy": []
  }
}
